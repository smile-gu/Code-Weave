{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-weave.local/schemas/review-snapshot-manifest-v1.schema.json",
  "title": "Review Snapshot Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotFormatVersion", "snapshotId", "codingSessionId", "baseCommit", "capturedHeadCommit", "branch", "workspaceFingerprint", "createdAt", "targetPaths", "excludedChangedPaths", "entries", "changes"],
  "properties": {
    "snapshotFormatVersion": { "const": "1.0" },
    "snapshotId": { "$ref": "review-harness-common-v1.schema.json#/$defs/uuid" },
    "codingSessionId": { "$ref": "review-harness-common-v1.schema.json#/$defs/uuid" },
    "baseCommit": { "$ref": "#/$defs/gitOid" },
    "capturedHeadCommit": { "$ref": "#/$defs/gitOid" },
    "branch": { "type": "string", "minLength": 1 },
    "workspaceFingerprint": { "$ref": "review-harness-common-v1.schema.json#/$defs/sha256" },
    "createdAt": { "$ref": "review-harness-common-v1.schema.json#/$defs/utcTimestamp" },
    "targetPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "excludedChangedPaths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "changes": {
      "type": "object", "additionalProperties": false, "required": ["files", "diff"],
      "properties": {
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/change" } },
        "diff": {
          "type": "object", "additionalProperties": false, "required": ["path", "byteSize", "diffSha256"],
          "properties": {
            "path": { "const": "artifacts/changes.diff" },
            "byteSize": { "type": "integer", "minimum": 0 },
            "diffSha256": { "$ref": "review-harness-common-v1.schema.json#/$defs/sha256" }
          }
        }
      }
    }
  },
  "$defs": {
    "gitOid": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))[^\\\\:\\u0000]+$" },
    "entry": {
      "type": "object", "additionalProperties": false, "required": ["path", "type", "tracked", "gitMode", "byteSize", "contentSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "type": { "enum": ["REGULAR_FILE", "SYMLINK"] },
        "tracked": { "type": "boolean" },
        "gitMode": { "enum": ["100644", "100755", "120000"] },
        "byteSize": { "type": "integer", "minimum": 0 },
        "contentSha256": { "$ref": "review-harness-common-v1.schema.json#/$defs/sha256" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "SYMLINK" } } }, "then": { "properties": { "gitMode": { "const": "120000" } } }, "else": { "properties": { "gitMode": { "enum": ["100644", "100755"] } } } }
      ]
    },
    "change": {
      "type": "object", "additionalProperties": false, "required": ["path", "oldPath", "changeType", "binary", "gitMode"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "oldPath": { "anyOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
        "changeType": { "enum": ["ADDED", "MODIFIED", "DELETED", "RENAMED"] },
        "binary": { "type": "boolean" },
        "gitMode": { "enum": ["000000", "100644", "100755", "120000"] }
      },
      "allOf": [
        { "if": { "properties": { "changeType": { "const": "RENAMED" } } }, "then": { "properties": { "oldPath": { "$ref": "#/$defs/path" } } }, "else": { "properties": { "oldPath": { "type": "null" } } } },
        { "if": { "properties": { "changeType": { "const": "DELETED" } } }, "then": { "properties": { "gitMode": { "const": "000000" } } }, "else": { "properties": { "gitMode": { "enum": ["100644", "100755", "120000"] } } } }
      ]
    }
  }
}
