{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-weave.local/schemas/review-harness-common-v1.schema.json",
  "title": "Code Weave Review Harness Common Types v1",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "runStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "RUNNING",
        "CANCELLING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "resourceState": {
      "type": "string",
      "enum": [
        "NOT_ACQUIRED",
        "ACTIVE",
        "RELEASING",
        "RELEASED",
        "UNCERTAIN"
      ]
    },
    "resultDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultId", "resultVersion", "resultSha256"],
      "properties": {
        "resultId": { "$ref": "#/$defs/uuid" },
        "resultVersion": { "enum": ["1.0", "2.0"] },
        "resultSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "diagnosticId"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "diagnosticId": { "$ref": "#/$defs/uuid" }
      }
    }
  }
}
