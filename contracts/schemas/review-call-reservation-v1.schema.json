{
  "additionalProperties": false,
  "properties": {
    "runId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Runid",
      "type": "string"
    },
    "modelCallId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Modelcallid",
      "type": "string"
    },
    "passId": {
      "enum": [
        "correctness",
        "consistency",
        "security",
        "performance",
        "architecture",
        "testing",
        "dedup"
      ],
      "title": "Passid",
      "type": "string"
    },
    "state": {
      "enum": [
        "RESERVED",
        "DISPATCHING",
        "SETTLED",
        "UNKNOWN",
        "REFUNDED"
      ],
      "title": "State",
      "type": "string"
    },
    "reservedMicros": {
      "exclusiveMinimum": 0,
      "maximum": 9223372036854775807,
      "title": "Reservedmicros",
      "type": "integer"
    },
    "actualMicros": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Actualmicros"
    },
    "overrunMicros": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Overrunmicros",
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "runId",
    "modelCallId",
    "passId",
    "state",
    "reservedMicros",
    "actualMicros",
    "overrunMicros",
    "revision"
  ],
  "title": "CallReservation",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-weave.local/schemas/review-call-reservation-v1.schema.json"
}
