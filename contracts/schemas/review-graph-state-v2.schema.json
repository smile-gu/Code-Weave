{
  "$defs": {
    "ArtifactProgress": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Artifactid",
          "type": "string"
        },
        "nextCursor": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nextcursor"
        },
        "completed": {
          "default": false,
          "title": "Completed",
          "type": "boolean"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "startLine": {
          "minimum": 1,
          "title": "Startline",
          "type": "integer"
        },
        "endLine": {
          "minimum": 0,
          "title": "Endline",
          "type": "integer"
        },
        "finalPage": {
          "title": "Finalpage",
          "type": "boolean"
        },
        "readable": {
          "title": "Readable",
          "type": "boolean"
        }
      },
      "required": [
        "artifactId",
        "path",
        "startLine",
        "endLine",
        "finalPage",
        "readable"
      ],
      "title": "ArtifactProgress",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Artifactid",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byteSize": {
          "minimum": 0,
          "title": "Bytesize",
          "type": "integer"
        },
        "coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "SAMPLED"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "redactionState": {
          "enum": [
            "NONE",
            "APPLIED",
            "NOT_APPLICABLE"
          ],
          "title": "Redactionstate",
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "sha256",
        "byteSize",
        "coverage",
        "redactionState"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CodeReference": {
      "additionalProperties": false,
      "properties": {
        "sourceType": {
          "const": "CODE",
          "title": "Sourcetype",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "side": {
          "enum": [
            "base",
            "final",
            "diff"
          ],
          "title": "Side",
          "type": "string"
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "startLine": {
          "minimum": 1,
          "title": "Startline",
          "type": "integer"
        },
        "endLine": {
          "minimum": 1,
          "title": "Endline",
          "type": "integer"
        }
      },
      "required": [
        "sourceType",
        "path",
        "side",
        "sha256",
        "startLine",
        "endLine"
      ],
      "title": "CodeReference",
      "type": "object"
    },
    "GraphMessage": {
      "additionalProperties": false,
      "properties": {
        "messageId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Messageid",
          "type": "string"
        },
        "role": {
          "enum": [
            "assistant",
            "tool",
            "user"
          ],
          "title": "Role",
          "type": "string"
        },
        "content": {
          "maxLength": 16384,
          "title": "Content",
          "type": "string"
        },
        "toolCalls": {
          "items": {
            "$ref": "#/$defs/ToolCall"
          },
          "maxItems": 8,
          "title": "Toolcalls",
          "type": "array"
        },
        "toolCallId": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Toolcallid"
        },
        "artifactRefs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "maxItems": 32,
          "title": "Artifactrefs",
          "type": "array"
        },
        "sourceRefs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 32,
          "title": "Sourcerefs",
          "type": "array"
        }
      },
      "required": [
        "messageId",
        "role",
        "content"
      ],
      "title": "GraphMessage",
      "type": "object"
    },
    "Inspection": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "coverage": {
          "enum": [
            "FULL",
            "PARTIAL"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "ranges": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "maxItems": 32,
          "title": "Ranges",
          "type": "array"
        },
        "finalLine": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finalline"
        }
      },
      "required": [
        "path",
        "coverage"
      ],
      "title": "Inspection",
      "type": "object"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "modelCallId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Modelcallid",
          "type": "string"
        },
        "estimatedInputTokens": {
          "minimum": 0,
          "title": "Estimatedinputtokens",
          "type": "integer"
        },
        "inputUnits": {
          "minimum": 0,
          "title": "Inputunits",
          "type": "integer"
        },
        "outputUnits": {
          "minimum": 0,
          "title": "Outputunits",
          "type": "integer"
        }
      },
      "required": [
        "modelCallId",
        "estimatedInputTokens",
        "inputUnits",
        "outputUnits"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "ProviderCallMapping": {
      "additionalProperties": false,
      "properties": {
        "modelCallId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Modelcallid",
          "type": "string"
        },
        "toolCallId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Toolcallid",
          "type": "string"
        },
        "providerToolCallId": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Providertoolcallid",
          "type": "string"
        }
      },
      "required": [
        "modelCallId",
        "toolCallId",
        "providerToolCallId"
      ],
      "title": "ProviderCallMapping",
      "type": "object"
    },
    "ReasoningSummary": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rule",
          "type": "string"
        },
        "trigger": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Trigger",
          "type": "string"
        },
        "executionPath": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Executionpath",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Assumptions",
          "type": "array"
        },
        "counterexamples": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Counterexamples",
          "type": "array"
        },
        "conclusion": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Conclusion",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "trigger",
        "executionPath",
        "assumptions",
        "counterexamples",
        "conclusion"
      ],
      "title": "ReasoningSummary",
      "type": "object"
    },
    "ReviewCandidate": {
      "additionalProperties": false,
      "properties": {
        "passId": {
          "const": "correctness",
          "title": "Passid",
          "type": "string"
        },
        "category": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Category",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "claim": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Claim",
          "type": "string"
        },
        "severity": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "reasoningSummary": {
          "$ref": "#/$defs/ReasoningSummary"
        },
        "suggestion": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Suggestion",
          "type": "string"
        },
        "claimKind": {
          "enum": [
            "STATIC_CORRECTNESS",
            "ENVIRONMENT_DEPENDENT",
            "QUANTITATIVE"
          ],
          "title": "Claimkind",
          "type": "string"
        },
        "evidenceIds": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidenceids",
          "type": "array"
        },
        "codeReferences": {
          "items": {
            "$ref": "#/$defs/CodeReference"
          },
          "maxItems": 16,
          "title": "Codereferences",
          "type": "array"
        },
        "candidateId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Candidateid",
          "type": "string"
        }
      },
      "required": [
        "passId",
        "category",
        "title",
        "claim",
        "severity",
        "confidence",
        "reasoningSummary",
        "suggestion",
        "claimKind",
        "evidenceIds",
        "codeReferences",
        "candidateId"
      ],
      "title": "ReviewCandidate",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "contentSha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contentsha256"
        },
        "diffSha256": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diffsha256"
        },
        "startLine": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Startline"
        },
        "endLine": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endline"
        }
      },
      "title": "SourceRef",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "properties": {
        "toolCallId": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Toolcallid",
          "type": "string"
        },
        "providerToolCallId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Providertoolcallid"
        },
        "name": {
          "enum": [
            "read_file",
            "search_code",
            "glob_files",
            "git_diff",
            "read_artifact"
          ],
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "toolCallId",
        "name",
        "arguments"
      ],
      "title": "ToolCall",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "stateVersion": {
      "const": "2.0",
      "default": "2.0",
      "title": "Stateversion",
      "type": "string"
    },
    "runId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Runid",
      "type": "string"
    },
    "reviewThreadId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Reviewthreadid",
      "type": "string"
    },
    "snapshotId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Snapshotid",
      "type": "string"
    },
    "manifestSha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifestsha256",
      "type": "string"
    },
    "investigationId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Investigationid",
      "type": "string"
    },
    "passId": {
      "const": "correctness",
      "default": "correctness",
      "title": "Passid",
      "type": "string"
    },
    "userGoalDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Usergoaldigest",
      "type": "string"
    },
    "scopeDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scopedigest",
      "type": "string"
    },
    "toolSetDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Toolsetdigest",
      "type": "string"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "summaryVersion": {
      "default": 0,
      "minimum": 0,
      "title": "Summaryversion",
      "type": "integer"
    },
    "summaryArtifactRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/GraphMessage"
      },
      "maxItems": 128,
      "title": "Messages",
      "type": "array"
    },
    "artifactRefs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 64,
      "title": "Artifactrefs",
      "type": "array"
    },
    "sourceRefs": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "maxItems": 64,
      "title": "Sourcerefs",
      "type": "array"
    },
    "evidenceRefs": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 128,
      "title": "Evidencerefs",
      "type": "array"
    },
    "candidateRefs": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Candidaterefs",
      "type": "array"
    },
    "sourceMessageIds": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 128,
      "title": "Sourcemessageids",
      "type": "array"
    },
    "sourceDigest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sourcedigest"
    },
    "pendingToolCalls": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Pendingtoolcalls",
      "type": "array"
    },
    "modelCallCount": {
      "default": 0,
      "maximum": 16,
      "minimum": 0,
      "title": "Modelcallcount",
      "type": "integer"
    },
    "compactionCount": {
      "default": 0,
      "maximum": 8,
      "minimum": 0,
      "title": "Compactioncount",
      "type": "integer"
    },
    "graphStepCount": {
      "default": 0,
      "maximum": 160,
      "minimum": 0,
      "title": "Graphstepcount",
      "type": "integer"
    },
    "lastContextManifestRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "modelUsages": {
      "items": {
        "$ref": "#/$defs/ModelUsage"
      },
      "maxItems": 16,
      "title": "Modelusages",
      "type": "array"
    },
    "providerCallMappings": {
      "items": {
        "$ref": "#/$defs/ProviderCallMapping"
      },
      "title": "Providercallmappings",
      "type": "array"
    },
    "toolCallCount": {
      "default": 0,
      "minimum": 0,
      "title": "Toolcallcount",
      "type": "integer"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ReviewCandidate"
      },
      "maxItems": 32,
      "title": "Candidates",
      "type": "array"
    },
    "inspections": {
      "items": {
        "$ref": "#/$defs/Inspection"
      },
      "maxItems": 128,
      "title": "Inspections",
      "type": "array"
    },
    "artifactProgress": {
      "items": {
        "$ref": "#/$defs/ArtifactProgress"
      },
      "maxItems": 32,
      "title": "Artifactprogress",
      "type": "array"
    },
    "diffNextCursor": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Diffnextcursor"
    },
    "diffStarted": {
      "default": false,
      "title": "Diffstarted",
      "type": "boolean"
    },
    "diffCompleted": {
      "default": false,
      "title": "Diffcompleted",
      "type": "boolean"
    },
    "correctionCount": {
      "default": 0,
      "maximum": 2,
      "minimum": 0,
      "title": "Correctioncount",
      "type": "integer"
    }
  },
  "required": [
    "runId",
    "reviewThreadId",
    "snapshotId",
    "manifestSha256",
    "investigationId",
    "userGoalDigest",
    "scopeDigest",
    "toolSetDigest"
  ],
  "title": "RealReviewGraphState",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-weave.local/schemas/review-graph-state-v2.schema.json"
}
