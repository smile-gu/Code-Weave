# Set absolute independent local roots outside user repositories.
CODE_WEAVE_REVIEW_SNAPSHOT_ROOT=D:/code-weave-runtime/snapshots
CODE_WEAVE_REVIEW_EXECUTION_ROOT=D:/code-weave-runtime/executions
CODE_WEAVE_REVIEW_ARTIFACT_ROOT=D:/code-weave-runtime/artifacts
CODE_WEAVE_REVIEW_DATABASE_URL=sqlite+aiosqlite:///D:/code-weave-runtime/runs.sqlite
# Supply a real credential out of band; this placeholder is rejected.
CODE_WEAVE_REVIEW_INTERNAL_BEARER_TOKEN=change-me
CODE_WEAVE_REVIEW_ARTIFACT_MAX_BYTES=8388608
CODE_WEAVE_REVIEW_ARTIFACT_RUN_BYTES=67108864
