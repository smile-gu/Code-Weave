# Set absolute independent local roots outside user repositories.
CODE_WEAVE_REVIEW_SNAPSHOT_ROOT=D:/code-weave-runtime/snapshots
CODE_WEAVE_REVIEW_EXECUTION_ROOT=D:/code-weave-runtime/executions
CODE_WEAVE_REVIEW_ARTIFACT_ROOT=D:/code-weave-runtime/artifacts
CODE_WEAVE_REVIEW_DATABASE_URL=sqlite+aiosqlite:///D:/code-weave-runtime/runs.sqlite
# Supply a real credential out of band; this placeholder is rejected.
CODE_WEAVE_REVIEW_INTERNAL_BEARER_TOKEN=change-me
CODE_WEAVE_REVIEW_ARTIFACT_MAX_BYTES=8388608
CODE_WEAVE_REVIEW_ARTIFACT_RUN_BYTES=67108864
CODE_WEAVE_REVIEW_ARTIFACT_RUN_COUNT=256
CODE_WEAVE_REVIEW_TOOL_OUTPUT_BYTES=32768
CODE_WEAVE_REVIEW_TOOL_TIMEOUT_SECONDS=10
CODE_WEAVE_REVIEW_TOOL_SCAN_BYTES=67108864
# Optional independent database; omission disables checkpoint capability only.
# Parent directory must exist. Must not alias product DB or material roots.
CODE_WEAVE_REVIEW_CHECKPOINT_DATABASE_URL=sqlite+aiosqlite:///D:/code-weave-runtime/graph.sqlite
CODE_WEAVE_REVIEW_GRAPH_MAX_STEPS=16
CODE_WEAVE_REVIEW_GRAPH_MAX_MODEL_CALLS=16
CODE_WEAVE_REVIEW_COMPACTION_ATTEMPTS=2
CODE_WEAVE_REVIEW_COMPACTION_MAX_SUCCESSES=8
CODE_WEAVE_REVIEW_MODEL_TIMEOUT_SECONDS=10
