{
  "name": "@code-weave/web-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:legacy-worktree-run": "tsc -p tsconfig.legacy-worktree-run.json",
    "test": "vitest run",
    "test:legacy-worktree-run": "vitest run --config vite.legacy-worktree-run.config.ts",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tanstack/react-query": "^5.101.4",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "motion": "^14.3.0",
    "react": "^19.2.8",
    "react-diff-view": "^3.3.3",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
